<?xml version="1.0" encoding="utf-8"?>

<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:layouts="clr-namespace:WidgetBoard.App.Layouts"
      x:Class="WidgetBoard.App.Layouts.BoardLayout"
      x:Name="self">

    <Grid x:Name="placeholderGrid" />
    <Grid x:Name="widgetGrid"
          ChildAdded="OnWidgetsChildAdded"
          BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference self}, x:DataType=layouts:BoardLayout}"
          BindableLayout.ItemTemplateSelector="{Binding ItemTemplateSelector, Source={x:Reference self}, x:DataType=layouts:BoardLayout}"
          InputTransparent="True"
          CascadeInputTransparent="False" />
</Grid>