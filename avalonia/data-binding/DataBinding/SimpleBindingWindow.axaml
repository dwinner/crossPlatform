<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataBinding"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DataBinding.SimpleBindingWindow"
        Title="SimpleBindingWindow"
        x:DataType="local:Person">
    <StackPanel>
        <TextBlock Text="Name:" />
        <TextBox Text="{Binding FullName, Mode=OneWay}" />

        <TextBlock Text="Date of birth:" />
        <DatePicker SelectedDate="{Binding DateOfBirth, Mode=TwoWay}" />

        <TextBlock Text="Address:" />
        <TextBox Text="{Binding Address, Mode=OneWay}" />
    </StackPanel>
</Window>