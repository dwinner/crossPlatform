<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="Black"
             x:Class="FancyCalc.MainPage">

    <Grid ColumnDefinitions="100,100,100,100"
          RowDefinitions="*,100,100,100,100"
          HorizontalOptions="Center"
          Margin="50"
          x:Name="ButtonGrid">
        <Label Grid.Row="0"
               Grid.Column="0"
               Grid.ColumnSpan="4"
               BackgroundColor="Black"
               FontFamily="LCD"
               FontSize="72"
               Padding="20"
               TextColor="Red"
               HorizontalTextAlignment="End"
               VerticalTextAlignment="End"
               x:Name="LCD"/>

        <Button Grid.Row="1"
                Grid.Column="0"
                Text="7"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="1"
                Grid.Column="1"
                Text="8"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="1"
                Grid.Column="2"
                Text="9"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="2"
                Grid.Column="0"
                Text="4"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="2"
                Grid.Column="1"
                Text="5"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="2"
                Grid.Column="2"
                Text="6"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="3"
                Grid.Column="0"
                Text="1"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="3"
                Grid.Column="1"
                Text="2"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="3"
                Grid.Column="2"
                Text="3"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="4"
                Grid.Column="0"
                Text="."
                Clicked="Button_Clicked"/>

        <Button Grid.Row="4"
                Grid.Column="1"
                Text="0"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="4"
                Grid.Column="2"
                Text="="
                Clicked="Button_Clicked"/>

        <Button Grid.Row="1"
                Grid.Column="3"
                Text="+"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="2"
                Grid.Column="3"
                Text="-"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="3"
                Grid.Column="3"
                Text="X"
                Clicked="Button_Clicked"/>

        <Button Grid.Row="4"
                Grid.Column="3"
                Text="/"
                Clicked="Button_Clicked"/>
    </Grid>
</ContentPage>
