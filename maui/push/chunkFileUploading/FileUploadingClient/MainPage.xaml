<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fileUploadingClient="clr-namespace:FileUploadingClient"
             x:Class="FileUploadingClient.MainPage">
    <ContentPage.BindingContext>
        <fileUploadingClient:MainViewModel />
    </ContentPage.BindingContext>
    <VerticalStackLayout VerticalOptions="Center"
                         Spacing="10"
                         Padding="10">
        <Button Text="Upload file"
                Command="{Binding UploadFileCommand}" />
        <Label Text="{Binding FileName}" />
        <ProgressBar Progress="{Binding UploadProgress}" />
        <Label Text="{Binding TextProgress}" />
    </VerticalStackLayout>
</ContentPage>